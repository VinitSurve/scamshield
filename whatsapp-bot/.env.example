# ScamShield WhatsApp Bot Configuration

# Operating Mode: 'demo' (mock delivery for hackathon demonstration) or 'cloud_api' (official Meta WhatsApp Business API)
WHATSAPP_MODE=demo
WHATSAPP_ENABLED=true

# Server Port
PORT=3001

# Meta WhatsApp Cloud API Credentials (Required ONLY for live cloud_api mode)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=scamshield_webhook_secret_verify_token_2026
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_validation

# Threat Scanner Backend URL (optional override)
SCAMSHIELD_API_URL=https://api.scamshield.org
