# ScamShield Browser Extension Configuration Example
# Copy this file to '.env.local' in this directory (which is git-ignored) for local development.
# NEVER put real API keys in this file (.env.example) because it is tracked in Git!

# Base URL for ScamShield Intelligence API Gateway (Public REST API)
VITE_SCAMSHIELD_API_URL=https://api.scamshield.org

# Development / Demo Mode Toggle
# When true, uses local deterministic threat intelligence if backend is unreachable
VITE_DEMO_MODE=false

# ==============================================================================
# Optional Developer AI Key Auto-Seeding (For Local Testing Only)
# ==============================================================================
# Put your real keys inside 'extension/.env.local' (git-ignored) or in Options UI:
#
# Google Gemini API Keys (comma-separated for multi-key pool):
# VITE_DEV_GEMINI_KEYS=your_gemini_key_1,your_gemini_key_2
#
# Groq API Keys (comma-separated for multi-key pool):
# VITE_DEV_GROQ_KEYS=your_groq_key_1,your_groq_key_2
